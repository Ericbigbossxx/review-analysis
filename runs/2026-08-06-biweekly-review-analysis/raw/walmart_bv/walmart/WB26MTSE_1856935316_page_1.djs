ass=\"BVDI_BAItem BVDI_BAItemOdd BVDI_BAItemStaff\"><div id=\"BVDI_BAPopup_9su7vif05cmjwnzlo08mz63rx_ID\" class=\"BVDIPopup BVDI_BAPopup BVDI_BAPopupStaff\" style=\"display: none;\"><div class=\"BVDIInside BVDI_BAInsidePopup\"><div class=\"BVDIBody BVDI_BAPopupBody\"><dl class=\"BVDI_BAList\"><dt class=\"BVDI_BAItem BVDI_BAItemOnly BVDI_BAItemStaff\">\n<a onclick=\"return false;\" class=\"BVDILink BVDILinkDisabled\"> <span class=\"BVDILinkSpan\">Walmart Associate<\/span><\/a><\/dt><dd>A Walmart Associate is an employee of Walmart, Walmart.com or Sam's Club.<\/dd><\/dl><\/div><\/div><\/div>\n<a onclick=\"return false;\" class=\"BVDILink BVDILinkDisabled\" id=\"BVDI_BABadge_a4bhwkave4r31p1vfjb686x0j_ID\"onmouseover=\"bvTooltip.show(&quot;BVDI_BAPopup_9su7vif05cmjwnzlo08mz63rx_ID&quot;, this.id, false, []);\"onmouseout=\"bvTooltip.hide();\"> <span class=\"BVDILinkSpan\">Walmart Associate<\/span><\/a><\/li><li class=\"BVDI_BAItem BVDI_BAItemEven BVDI_BAItemVerifiedPurchaser\"><div id=\"BVDI_BAPopup_qgqgzs7nm6sfat21pze3cgk89_ID\" class=\"BVDIPopup BVDI_BAPopup BVDI_BAPopupVerifiedPurchaser\" style=\"display: none;\"><div class=\"BVDIInside BVDI_BAInsidePopup\"><div class=\"BVDIBody BVDI_BAPopupBody\"><dl class=\"BVDI_BAList\"><dt class=\"BVDI_BAItem BVDI_BAItemOnly BVDI_BAItemVerifiedPurchaser\">\n<a onclick=\"return false;\" class=\"BVDILink BVDILinkDisabled\"> <span class=\"BVDILinkSpan\">Verified Purchaser<\/span><\/a><\/dt><dd><p>Customer has been confirmed to have purchased the item from Walmart.<\/p><\/dd><\/dl><\/div><\/div><\/div>\n<a onclick=\"return false;\" class=\"BVDILink BVDILinkDisabled\" id=\"BVDI_BABadge_hky9f889nzey0rovnak5or5k6_ID\"onmouseover=\"bvTooltip.show(&quot;BVDI_BAPopup_qgqgzs7nm6sfat21pze3cgk89_ID&quot;, this.id, false, []);\"onmouseout=\"bvTooltip.hide();\"> <span class=\"BVDILinkSpan\">Verified Purchaser<\/span><\/a><\/li><\/ul><\/div><\/div><\/div>\n <div class=\"BVRRCustomUserInfoContainer\">\n<div class=\"BVRRContextDataContainer\"><\/div> <\/div>\n\n\n\n\n\n\n<\/div>\n<div class=\"BVRRReviewDisplayStyle3Main\">\n <div class=\"BVRRReviewDisplayStyle3MainSpacer BVRRReviewDisplayStyle3MainSpacerTop\"><\/div>\n\n<div class=\"BVRRReviewRatingsContainer\"> <div class=\"BVRROverallRatingContainer\" >\n<div class=\"BVRRRatingContainerStar\"><div class=\"BVRRRatingEntry BVRROdd\"><div id=\"BVRRRatingOverall_Review_Display\" class=\"BVRRRating BVRRRatingNormal BVRRRatingOverall\"><div class=\"BVRRLabel BVRRRatingNormalLabel\"><\/div><div class=\"BVRRRatingNormalImage\">\n<div class=\"BVImgOrSprite\" style=\"width:75px;height:15px;overflow:hidden\"><img src=\"https://walmart.ugc.bazaarvoice.com/1336/5_0/9/rating.png\" alt=\"3 out of 5\" title=\"3 out of 5\" width=\"135\" height=\"15\" style=\"margin-left:-30px\" />\n<\/div><\/div>\n<div itemprop=\"reviewRating\" itemscope itemtype=\"https://schema.org/Rating\" class=\"BVRRRatingNormalOutOf\"> <span itemprop=\"ratingValue\" class=\"BVRRNumber BVRRRatingNumber\">3<\/span>\n <span class=\"BVRRSeparatorText\">out of<\/span>\n <span itemprop=\"bestRating\" class=\"BVRRNumber BVRRRatingRangeNumber\">5<\/span>\n<\/div><\/div><\/div><\/div> <\/div>\n<\/div>\n<div class=\"BVRRReviewTitleContainer\"><span class=\"BVRRLabel BVRRReviewTitlePrefix\"><\/span><span itemprop=\"name\" class=\"BVRRValue BVRRReviewTitle\">Good Overall<\/span><span class=\"BVRRLabel BVRRReviewTitleSuffix\">, <\/span><\/div>\n<div class=\"BVRRReviewDateContainer\"><span class=\"BVRRLabel BVRRReviewDatePrefix\"><\/span><span class=\"BVRRValue BVRRReviewDate\">05/05/2024<meta itemprop=\"datePublished\" content=\"2024-05-05\"/><\/span><span class=\"BVRRLabel BVRRReviewDateSuffix\"><\/span><\/div>\n<div class=\"BVRRReviewDisplayStyle3Content\">\n <div itemprop=\"description\" class=\"BVRRReviewTextContainer\" >\n\n\n\n\n<div id=\"BVRRReviewAbbreviatedText343645079_2jks1dfj34wj630jf09l8mw2n_ID\" class=\"BVRRReviewAbbreviatedText\"><div class=\"BVRRReviewAbbreviatedTextParagraph BVRRReviewAbbreviatedTextFirstParagraph BVRRReviewAbbreviatedTextLastParagraph\"> <span class=\"BVRRReviewAbbreviatedText\">Motor is strong and works as well as sounds good. The attachments are trash especially the edger. I would strongly recommend the motor but not any attachments weed trimmer only useful the gear boxes on attachments are not work the struggle of<\/span>\n<span class=\"BVRRReviewAbbreviatedTextSuffix\"><span class=\"BVDI_AbbreviatedLinkPrefix\">...<\/span><span class=\"BVDI_AbbreviatedLink\"><a onclick=\" if(window.BVAnalyticsTracker){BVAnalyticsTracker.fireActionEvent(this);};&#10;$bv('#BVRRReviewAbbreviatedText343645079_2jks1dfj34wj630jf09l8mw2n_ID').toggleClass('BVDIHidden');$bv('#BVRRReview343645079_e8gyya82ceitqivy5g6g2o8py_ID').toggleClass('BVDIHidden');bvStopPropagation(event);return false;\" name=\"BV_TrackingTag_Review_Display_ToggleReadMore\" href=\"#\" class=\"BVDILink \"><span class=\"BVDILinkSpan\">(read full review)<\/span><\/a><\/span><span class=\"BVDI_AbbreviatedLinkSuffix\"><\/span><\/span><\/div><\/div>\n<div id=\"BVRRReview343645079_e8gyya82ceitqivy5g6g2o8py_ID\" class=\"BVRRReviewText BVDIHidden\"><div class=\"BVRRReviewTextParagraph BVRRReviewTextFirstParagraph BVRRReviewTextLastParagraph\"> <span class=\"BVRRReviewText\">Motor is strong and works as well as sounds good. The attachments are trash especially the edger. I would strongly recommend the motor but not any attachments weed trimmer only useful the gear boxes on attachments are not work the struggle of attaching and attempting to work with.<\/span>\n<span class=\"BVRRReviewTextSuffix\"><span class=\"BVDI_FullLinkPrefix\"><\/span><span class=\"BVDI_FullLink\"><a onclick=\" if(window.BVAnalyticsTracker){BVAnalyticsTracker.fireActionEvent(this);};&#10;$bv('#BVRRReviewAbbreviatedText343645079_2jks1dfj34wj630jf09l8mw2n_ID').toggleClass('BVDIHidden');$bv('#BVRRReview343645079_e8gyya82ceitqivy5g6g2o8py_ID').toggleClass('BVDIHidden');bvStopPropagation(event);return false;\" name=\"BV_TrackingTag_Re