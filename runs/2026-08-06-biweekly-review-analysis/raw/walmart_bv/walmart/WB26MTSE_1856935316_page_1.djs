wRating\" itemscope itemtype=\"https://schema.org/Rating\" class=\"BVRRRatingNormalOutOf\"> <span itemprop=\"ratingValue\" class=\"BVRRNumber BVRRRatingNumber\">4<\/span>\n <span class=\"BVRRSeparatorText\">out of<\/span>\n <span itemprop=\"bestRating\" class=\"BVRRNumber BVRRRatingRangeNumber\">5<\/span>\n<\/div><\/div><\/div><\/div> <\/div>\n<\/div>\n<div class=\"BVRRReviewTitleContainer\"><span class=\"BVRRLabel BVRRReviewTitlePrefix\"><\/span><span itemprop=\"name\" class=\"BVRRValue BVRRReviewTitle\">Super reliable<\/span><span class=\"BVRRLabel BVRRReviewTitleSuffix\">, <\/span><\/div>\n<div class=\"BVRRReviewDateContainer\"><span class=\"BVRRLabel BVRRReviewDatePrefix\"><\/span><span class=\"BVRRValue BVRRReviewDate\">08/02/2025<meta itemprop=\"datePublished\" content=\"2025-08-02\"/><\/span><span class=\"BVRRLabel BVRRReviewDateSuffix\"><\/span><\/div>\n<div class=\"BVRRReviewDisplayStyle3Content\">\n <div itemprop=\"description\" class=\"BVRRReviewTextContainer\" >\n\n\n\n\n<div id=\"BVRRReviewAbbreviatedText394173927_f593dnydw5ls4wql33vkkhazk_ID\" class=\"BVRRReviewAbbreviatedText\"><div class=\"BVRRReviewAbbreviatedTextParagraph BVRRReviewAbbreviatedTextFirstParagraph BVRRReviewAbbreviatedTextLastParagraph\"> <span class=\"BVRRReviewAbbreviatedText\">Super reliable the only thing I\u2019m having trouble with when I\u2019m putting the different attachments on it\u2019s a little hard to match the squares together so I can attach it but except that it\u2019s amazing and I use it for my house and some side jobs I do for<\/span>\n<span class=\"BVRRReviewAbbreviatedTextSuffix\"><span class=\"BVDI_AbbreviatedLinkPrefix\">...<\/span><span class=\"BVDI_AbbreviatedLink\"><a onclick=\" if(window.BVAnalyticsTracker){BVAnalyticsTracker.fireActionEvent(this);};&#10;$bv('#BVRRReviewAbbreviatedText394173927_f593dnydw5ls4wql33vkkhazk_ID').toggleClass('BVDIHidden');$bv('#BVRRReview394173927_q4294x5s212mt7e3ciulyz8te_ID').toggleClass('BVDIHidden');bvStopPropagation(event);return false;\" name=\"BV_TrackingTag_Review_Display_ToggleReadMore\" href=\"#\" class=\"BVDILink \"><span class=\"BVDILinkSpan\">(read full review)<\/span><\/a><\/span><span class=\"BVDI_AbbreviatedLinkSuffix\"><\/span><\/span><\/div><\/div>\n<div id=\"BVRRReview394173927_q4294x5s212mt7e3ciulyz8te_ID\" class=\"BVRRReviewText BVDIHidden\"><div class=\"BVRRReviewTextParagraph BVRRReviewTextFirstParagraph BVRRReviewTextLastParagraph\"> <span class=\"BVRRReviewText\">Super reliable the only thing I\u2019m having trouble with when I\u2019m putting the different attachments on it\u2019s a little hard to match the squares together so I can attach it but except that it\u2019s amazing and I use it for my house and some side jobs I do for my town<\/span>\n<span class=\"BVRRReviewTextSuffix\"><span class=\"BVDI_FullLinkPrefix\"><\/span><span class=\"BVDI_FullLink\"><a onclick=\" if(window.BVAnalyticsTracker){BVAnalyticsTracker.fireActionEvent(this);};&#10;$bv('#BVRRReviewAbbreviatedText394173927_f593dnydw5ls4wql33vkkhazk_ID').toggleClass('BVDIHidden');$bv('#BVRRReview394173927_q4294x5s212mt7e3ciulyz8te_ID').toggleClass('BVDIHidden');bvStopPropagation(event);return false;\" name=\"BV_TrackingTag_Review_Display_ToggleReadMore\" href=\"#\" class=\"BVDILink \"><span class=\"BVDILinkSpan\">(hide full review)<\/span><\/a><\/span><span class=\"BVDI_FullLinkSuffix\"><\/span><\/span><\/div><\/div> <\/div>\n\n\n\n\n\n<\/div>\n\n <div class=\"RRBeforeFeedbackContainerSpacer\"><\/div>\n\n\n<div class=\"BVDI_FV\"><div class=\"BVDI_FVVoting BVDI_FVVotingHelpfulness\"><div class=\"BVDI_FVSum BVDI_FVSumHelpfulness\"><span class=\"BVDI_FVZero BVDI_FVLevel1\"><span class=\"BVDIValue BVDINumber\">0<\/span><span class=\"BVDISuffix\">points<\/span><\/span><\/div><div class=\"BVDI_FVCounts BVDI_FVCountsHelpfulness\"><\/div><div class=\"BVDI_FVVotes BVDI_FVVotesHelpfulness\"><span class=\"BVDIPrefix\">Was this helpful?<\/span><span class=\"BVDI_FVVote BVDI_FVPositive BVDI_FVLevel1\"><a data-bvjsref=