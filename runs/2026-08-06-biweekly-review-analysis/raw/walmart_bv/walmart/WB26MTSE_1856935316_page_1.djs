k=\"return false;\" class=\"BVDILink BVDILinkDisabled\" id=\"BVDI_BABadge_7hdnh4rha6bhioz7ur5qrbpb9_ID\"onmouseover=\"bvTooltip.show(&quot;BVDI_BAPopup_axtgf3ak5b0iz9ir4d3me04uf_ID&quot;, this.id, false, []);\"onmouseout=\"bvTooltip.hide();\"> <span class=\"BVDILinkSpan\">This review was submitted as a PrizeIncentive<\/span><\/a><\/li><\/ul><\/div><\/div><\/div>\n <div class=\"BVRRCustomUserInfoContainer\">\n<div class=\"BVRRContextDataContainer\"><\/div> <\/div>\n\n\n\n\n\n\n<\/div>\n<div class=\"BVRRReviewDisplayStyle3Main\">\n <div class=\"BVRRReviewDisplayStyle3MainSpacer BVRRReviewDisplayStyle3MainSpacerTop\"><\/div>\n\n<div class=\"BVRRReviewRatingsContainer\"> <div class=\"BVRROverallRatingContainer\" >\n<div class=\"BVRRRatingContainerStar\"><div class=\"BVRRRatingEntry BVRROdd\"><div id=\"BVRRRatingOverall_Review_Display\" class=\"BVRRRating BVRRRatingNormal BVRRRatingOverall\"><div class=\"BVRRLabel BVRRRatingNormalLabel\"><\/div><div class=\"BVRRRatingNormalImage\">\n<div class=\"BVImgOrSprite\" style=\"width:75px;height:15px;overflow:hidden\"><img src=\"https://walmart.ugc.bazaarvoice.com/1336/5_0/9/rating.png\" alt=\"1 out of 5\" title=\"1 out of 5\" width=\"135\" height=\"15\" style=\"margin-left:-60px\" />\n<\/div><\/div>\n<div itemprop=\"reviewRating\" itemscope itemtype=\"https://schema.org/Rating\" class=\"BVRRRatingNormalOutOf\"> <span itemprop=\"ratingValue\" class=\"BVRRNumber BVRRRatingNumber\">1<\/span>\n <span class=\"BVRRSeparatorText\">out of<\/span>\n <span itemprop=\"bestRating\" class=\"BVRRNumber BVRRRatingRangeNumber\">5<\/span>\n<\/div><\/div><\/div><\/div> <\/div>\n<\/div>\n\n<div class=\"BVRRReviewDateContainer\"><span class=\"BVRRLabel BVRRReviewDatePrefix\"><\/span><span class=\"BVRRValue BVRRReviewDate\">06/14/2025<meta itemprop=\"datePublished\" content=\"2025-06-14\"/><\/span><span class=\"BVRRLabel BVRRReviewDateSuffix\"><\/span><\/div>\n<div class=\"BVRRReviewDisplayStyle3Content\">\n <div itemprop=\"description\" class=\"BVRRReviewTextContainer\" >\n\n\n\n\n<div id=\"BVRRReviewAbbreviatedText388671549_duebiezburw8aif8hhxzecn6z_ID\" class=\"BVRRReviewAbbreviatedText\"><div class=\"BVRRReviewAbbreviatedTextParagraph BVRRReviewAbbreviatedTextFirstParagraph BVRRReviewAbbreviatedTextLastParagraph\"> <span class=\"BVRRReviewAbbreviatedText\">The first one I ordered got lost in transit. The second one I ordered was delayed so I ordered a third one. One finally arrived, and I open the box. I could tell I\u2019ve been roughed up in transit. The cardboard was all shredded around the different<\/span>\n<span class=\"BVRRReviewAbbreviatedTextSuffix\"><span class=\"BVDI_AbbreviatedLinkPrefix\">...<\/span><span class=\"BVDI_AbbreviatedLink\"><a onclick=\" if(window.BVAnalyticsTracker){BVAnalyticsTracker.fireActionEvent(this);};&#10;$bv('#BVRRReviewAbbreviatedText388671549_duebiezburw8aif8hhxzecn6z_ID').toggleClass('BVDIHidden');$bv('#BVRRReview388671549_lybvpdmd3akflapc1l10ens49_ID').toggleClass('BVDIHidden');bvStopPropagation(event);return false;\" name=\"BV_TrackingTag_Review_Display_ToggleReadMore\" href=\"#\" class=\"BVDILink \"><span class=\"BVDILinkSpan\">(read full review)<\/span><\/a><\/span><span class=\"BVDI_AbbreviatedLinkSuffix\"><\/span><\/span><\/div><\/div>\n<div id=\"BVRRReview388671549_lybvpdmd3akflapc1l10ens49_ID\" class=\"BVRRReviewText BVDIHidden\"><div class=\"BVRRReviewTextParagraph BVRRReviewTextFirstParagraph BVRRReviewTextLastParagraph\"> <span class=\"BVRRReviewText\">The first one I ordered got lost in transit. The second one I ordered was delayed so I ordered a third one. One finally arrived, and I open the box. I could tell I\u2019ve been roughed up in transit. The cardboard was all shredded around the different parts and two of the shafts were pretty scratched up. Because of all the delays I couldn\u2019t afford to return it because I needed it for a job so now I\u2019m just stuck with it. Very disappointing all around and if I didn\u2019t need the tool so bad, I would\u2019ve gone through the process of returning it, but at this point it\u2019s just a huge hassle.<\/span>\n<span class=\"BVRRReviewTextSuffix\"><span class=\"BVDI_FullLinkPrefix\"><\/span><span class=\"BVDI_FullLink\"><a onclick=\" if(window.BVAnalyticsTracker){BVAnalyticsTracker.fireActionEvent(this);};&#10;$bv('#BVRRReviewAbbreviatedText388671549_duebiezburw8aif8hhxzecn6z_ID').toggleClass('BVDIHidden');$bv('#BVRRReview388671549_lybvpdmd3akflapc1l10ens49_ID').toggleClass('BVDIHidden');bvStopPropagation(event);return false;\" name=\"BV_TrackingTag_Review_Display_ToggleReadMore\" href=\"#\" class=\"BVDILink \"><span class=\"BVDILinkSpan\">(hide full review)<\/span><\/a><\/span><span class=\"BVDI_FullLinkSuffix\"><\/span><\/span><\/div><\/div> <\/div>\n\n\n\n\n\n<\/div>\n\n <div class=\"RRBeforeFeedbackContainerSpacer\"><\/div>\n\n\n<div class=\"BVDI_FV\"><div class=\"BVDI_FVVoting BVDI_FVVotingHelpfulness\"><div class=\"BVDI_FVSum BVDI_FVSumHelpfulness\"><span class=\"BVDI_FVPositive BVDI_FVLevel2\"><span class=\"BVDIPrefix\">+<\/span><span class=\"BVDIValue BVDINumber\">1<\/span><span class=\"BVDISuffix\">point<\/span><\/span><\/div><div class=\"BVDI_FVCounts BVDI_FVCountsHelpfulness\"><\/div><div class=\"BVDI_FVVotes BVDI_FVVotesHelpfulness\"><span class=\"BVDIPrefix\">Was this helpful?<\/span><span class=\"BVDI_FVVote BVDI_FVPositive BVDI_FVLevel2\"><a data-bvjsref=\"https://walmart.ugc.bazaarvoice.com/submit/1336/1856935316/review/388671549/positive.djs?authsourcetype=__AUTHTYPE__&amp;format=embeddedhtml&amp;innerreturn=https%3A%2F%2Fwalmart.ugc.bazaarvoice.com%2F1336%2F1856935316%2Freviews.djs%3Fformat%3Dembeddedhtml%26num%3D100%26sort%3DsubmissionTime&amp;return=__RETURN__&amp;sessionparams=__BVSESSIONPARAMS__&amp;submissionparams=__BVSUBMISSIONPARAMETERS__&amp;submissionurl=__BVSUBMISSIONURL__&amp;user=__USERID__\" data-bvcfg=\"__CONFIGKEY__\" name=\"BV_TrackingTag_Review_Display_AddPositiveFeedback_388671549\" href=\"javascript://\" title=\"Yes\" class=\"BVDI