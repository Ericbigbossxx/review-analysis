k9_ID\"onmouseover=\"bvTooltip.show(&quot;BVDI_BAPopup_71q8lmx15i3roe5zc983vw2l1_ID&quot;, this.id, false, []);\"onmouseout=\"bvTooltip.hide();\"> <span class=\"BVDILinkSpan\">Verified Purchaser<\/span><\/a><\/li><\/ul><\/div><\/div><\/div>\n <div class=\"BVRRCustomUserInfoContainer\">\n<div class=\"BVRRRecommendedContainer BVRRRecommendedContainerYes\"><span class=\"BVRRLabel BVRRRecommendedPrefix\">Recommends this product? <\/span><span class=\"BVRRValue BVRRRecommended\">Yes<\/span><span class=\"BVRRLabel BVRRRecommendedSuffix\"><\/span><\/div><div class=\"BVRRContextDataContainer\"><\/div> <\/div>\n\n\n\n\n\n\n<\/div>\n<div class=\"BVRRReviewDisplayStyle3Main\">\n <div class=\"BVRRReviewDisplayStyle3MainSpacer BVRRReviewDisplayStyle3MainSpacerTop\"><\/div>\n\n<div class=\"BVRRReviewRatingsContainer\"> <div class=\"BVRROverallRatingContainer\" >\n<div class=\"BVRRRatingContainerStar\"><div class=\"BVRRRatingEntry BVRROdd\"><div id=\"BVRRRatingOverall_Review_Display\" class=\"BVRRRating BVRRRatingNormal BVRRRatingOverall\"><div class=\"BVRRLabel BVRRRatingNormalLabel\"><\/div><div class=\"BVRRRatingNormalImage\">\n<div class=\"BVImgOrSprite\" style=\"width:75px;height:15px;overflow:hidden\"><img src=\"https://walmart.ugc.bazaarvoice.com/1336/5_0/9/rating.png\" alt=\"5 out of 5\" title=\"5 out of 5\" width=\"135\" height=\"15\" />\n<\/div><\/div>\n<div itemprop=\"reviewRating\" itemscope itemtype=\"https://schema.org/Rating\" class=\"BVRRRatingNormalOutOf\"> <span itemprop=\"ratingValue\" class=\"BVRRNumber BVRRRatingNumber\">5<\/span>\n <span class=\"BVRRSeparatorText\">out of<\/span>\n <span itemprop=\"bestRating\" class=\"BVRRNumber BVRRRatingRangeNumber\">5<\/span>\n<\/div><\/div><\/div><\/div> <\/div>\n<\/div>\n<div class=\"BVRRReviewTitleContainer\"><span class=\"BVRRLabel BVRRReviewTitlePrefix\"><\/span><span itemprop=\"name\" class=\"BVRRValue BVRRReviewTitle\">Perfect for a short Mama<\/span><span class=\"BVRRLabel BVRRReviewTitleSuffix\">, <\/span><\/div>\n<div class=\"BVRRReviewDateContainer\"><span class=\"BVRRLabel BVRRReviewDatePrefix\"><\/span><span class=\"BVRRValue BVRRReviewDate\">06/01/2025<meta itemprop=\"datePublished\" content=\"2025-06-01\"/><\/span><span class=\"BVRRLabel BVRRReviewDateSuffix\"><\/span><\/div>\n<div class=\"BVRRReviewDisplayStyle3Content\">\n <div itemprop=\"description\" class=\"BVRRReviewTextContainer\" >\n\n\n\n\n<div id=\"BVRRReviewAbbreviatedText387371137_b30990ve1kootukgfcz5xkes4_ID\" class=\"BVRRReviewAbbreviatedText\"><div class=\"BVRRReviewAbbreviatedTextParagraph BVRRReviewAbbreviatedTextFirstParagraph BVRRReviewAbbreviatedTextLastParagraph\"> <span class=\"BVRRReviewAbbreviatedText\">This set is exactly what I needed. It is a little heavy for me, however im 5ft tall and have a huge yard that requires a lot of trimming. If I shorten the length up, it may not be that bad. The blower is powerful, the batteries last much longer than<\/span>\n<span class=\"BVRRReviewAbbreviatedTextSuffix\"><span class=\"BVDI_AbbreviatedLinkPrefix\">...<\/span><span class=\"BVDI_AbbreviatedLink\"><a onclick=\" if(window.BVAnalyticsTracker){BVAnalyticsTracker.fireActionEvent(this);};&#10;$bv('#BVRRReviewAbbreviatedText387371137_b30990ve1kootukgfcz5xkes4_ID').toggleClass('BVDIHidden');$bv('#BVRRReview387371137_h73aafxf35gcsrf9bnhzb3hmy_ID').toggleClass('BVDIHidden');bvStopPropagation(event);return false;\" name=\"BV_TrackingTag_Review_Display_ToggleReadMore\" href=\"#\" class=\"BVDILink \"><span class=\"BVDILinkSpan\">(read full review)<\/span><\/a><\/span><span class=\"BVDI_AbbreviatedLinkSuffix\"><\/span><\/span><\/div><\/div>\n<div id=\"BVRRReview387371137_h73aafxf35gcsrf9bnhzb3hmy_ID\" class=\"BVRRReviewText BVDIHidden\"><div class=\"BVRRReviewTextParagraph BVRRReviewTextFirstParagraph BVRRReviewTextLastParagraph\"> <span class=\"BVRRReviewText\">This set is exactly what I needed. It is a little heavy for me, however im 5ft tall and have a huge yard that requires a lot of trimming. If I shorten the length up, it may not be that bad. The blower is powerful, the batteries last much longer than my Black n Decker. Overall I'm very happy with my purchase, its well worth the money.<\/span>\n<span class=\"BVRRReviewTextSuffix\"><span class=\"BVDI_FullLinkPrefix\"><\/span><span class=\"BVDI_FullLink\"><a onclick=\" if(window.BVAnalyticsTracker){BVAnalyticsTracker.fireActionEvent(this);};&#10;$bv('#BVRRReviewAbbreviatedText387371137_b30990ve1kootukgfcz5xkes4_ID').toggleClass('BVDIHidden');$bv('#BVRRReview387371137_h73aafxf35gcsrf9bnhzb3hmy_ID').toggleClass('BVDIHidden');bvStopPropagation(event);return false;\" name=\"BV_TrackingTag_Review_Display_ToggleReadMore\" href=\"#\" class=\"BVDILink \"><span class=\"BVDILinkSpan\">(hide full review)<\/span><\/a><\/span><span class=\"BVDI_FullLinkSuffix\"><\/span><\/span><\/div><\/div> <\/div>\n\n\n\n\n\n<\/div>\n\n <div class=\"RRBeforeFeedbackContainerSpacer\"><\/div>\n\n\n<div class=\"BVDI_FV\"><div class=\"BVDI_FVVoting BVDI_FVVotingHelpfulness\"><div class=\"BVDI_FVSum BVDI_FVSumHelpfulness\"><span class=\"BVDI_FVPositive BVDI_FVLevel2\"><span class=\"BVDIPrefix\">+<\/span><span class=\"BVDIValue BVDINumber\">2<\/span><span class=\"BVDISuffix\">points<\/span><\/span><\/div><div class=\"BVDI_FVCounts BVDI_FVCountsHelpfulness\"><\/div><div class=\"BVDI_FVVotes BVDI_FVVotesHelpfulness\"><span class=\"BVDIPrefix\">Was this helpful?<\/span><span class=\"BVDI_FVVote BVDI_FVPositive BVDI_FVLevel2\"><a data-bvjsref=\"https://walmart.ugc.bazaarvoice.com/submit/1336/864525478/review/387371137/positive.djs?authsourcetype=__AUTHTYPE__&amp;format=embeddedhtml&amp;innerreturn=https%3A%2F%2Fwalmart.ugc.bazaarvoice.com%2F1336%2F864525478%2Freviews.djs%3Fformat%3Dembeddedhtml%26num%3D100%26sort%3DsubmissionTime&amp;return=__RETURN__&amp;sessionparams=__BVSESSIONPARAMS__&amp;submissionparams=__BVSUBMISSIONPARAMETERS__&amp;submissionurl=__BVSUBMISSIONURL__&amp;user=__USERID__\" data-bvcfg=\"__CONFIGKEY__\" name=\"BV_TrackingTag_Review_Dis