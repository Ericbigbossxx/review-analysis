      "ProductId": "337020714",
      "OriginalProductName": "X7 Wireless 14 in. Robot Lawn Mower (0.75 Acre) with RTK Navigation, Vision AI System, Smart App Control",
      "CampaignId": "SubmitPilot2024",
      "ClientResponses": [
        {
          "Department": "Customer Care",
          "Response": "\nHello Larry.  I am sorry your warranty experience has not been great.  We try to give every repair the attention it needs in the order it was received.  Please email to Dan.barth&#64;sunseekertools.com your full name and serial number and I will look into this.\n    <img src=\"https://s3.amazonaws.com/stratos-logos/logos/Sunseeker.jpg\" alt=\"Sunseeker\" title=\"Sunseeker\" style=\"display: block !important; margin-top: 2em !important; border: 1px solid #ccc !important; padding: 2px !important; background-color: white !important;\" />\n<!--[if ReviewResponse]><![endif]-->",
          "ResponseSource": "Review Response",
          "Date": "2026-07-22T19:15:51.000+00:00",
          "SourceClientName": null
        }
      ],
      "UserLocation": "Kansas City",
      "AuthorId": "zstwu56b8rqbggrexcnqq9rpga",
      "ContentLocale": "en_US",
      "IsFeatured": false,
      "TotalInappropriateFeedbackCount": 0,
      "TotalClientResponseCount": 1,
      "TotalCommentCount": 0,
      "Rating": 1,
      "SecondaryRatingsOrder": [
        "Quality",
