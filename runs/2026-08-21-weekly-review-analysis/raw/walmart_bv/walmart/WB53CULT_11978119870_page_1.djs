\"onmouseover=\"bvTooltip.show(&quot;BVDI_BAPopup_3fic8lbqmjj8b3t5at5ccc5ek_ID&quot;, this.id, false, []);\"onmouseout=\"bvTooltip.hide();\"> <span class=\"BVDILinkSpan\">Verified Purchaser<\/span><\/a><\/li><li class=\"BVDI_BAItem BVDI_BAItemOdd BVDI_BAItemPrizeIncentive\"><div id=\"BVDI_BAPopup_aitryzeko92ppluglp6zxjrfe_ID\" class=\"BVDIPopup BVDI_BAPopup BVDI_BAPopupPrizeIncentive\" style=\"display: none;\"><div class=\"BVDIInside BVDI_BAInsidePopup\"><div class=\"BVDIBody BVDI_BAPopupBody\"><dl class=\"BVDI_BAList\"><dt class=\"BVDI_BAItem BVDI_BAItemOnly BVDI_BAItemPrizeIncentive\">\n<a onclick=\"return false;\" class=\"BVDILink BVDILinkDisabled\"> <span class=\"BVDILinkSpan\">This review was submitted as a PrizeIncentive<\/span><\/a><\/dt><dd>This review was submitted as a PrizeIncentive<\/dd><\/dl><\/div><\/div><\/div>\n<a onclick=\"return false;\" class=\"BVDILink BVDILinkDisabled\" id=\"BVDI_BABadge_t2f73rljas89squa88u2wu3gl_ID\"onmouseover=\"bvTooltip.show(&quot;BVDI_BAPopup_aitryzeko92ppluglp6zxjrfe_ID&quot;, this.id, false, []);\"onmouseout=\"bvTooltip.hide();\"> <span class=\"BVDILinkSpan\">This review was submitted as a PrizeIncentive<\/span><\/a><\/li><\/ul><\/div><\/div><\/div>\n <div class=\"BVRRCustomUserInfoContainer\">\n<div class=\"BVRRRecommendedContainer BVRRRecommendedContainerNo\"><span class=\"BVRRLabel BVRRRecommendedPrefix\">Recommends this product? <\/span><span class=\"BVRRValue BVRRRecommended\">No<\/span><span class=\"BVRRLabel BVRRRecommendedSuffix\"><\/span><\/div><div class=\"BVRRContextDataContainer\"><\/div> <\/div>\n\n\n\n\n\n\n<\/div>\n<div class=\"BVRRReviewDisplayStyle3Main\">\n <div class=\"BVRRReviewDisplayStyle3MainSpacer BVRRReviewDisplayStyle3MainSpacerTop\"><\/div>\n\n<div class=\"BVRRReviewRatingsContainer\"> <div class=\"BVRROverallRatingContainer\" >\n<div class=\"BVRRRatingContainerStar\"><div class=\"BVRRRatingEntry BVRROdd\"><div id=\"BVRRRatingOverall_Review_Display\" class=\"BVRRRating BVRRRatingNormal BVRRRatingOverall\"><div class=\"BVRRLabel BVRRRatingNormalLabel\"><\/div><div class=\"BVRRRatingNormalImage\">\n<div class=\"BVImgOrSprite\" style=\"width:75px;height:15px;overflow:hidden\"><img src=\"https://walmart.ugc.bazaarvoice.com/1336/5_0/9/rating.png\" alt=\"1 out of 5\" title=\"1 out of 5\" width=\"135\" height=\"15\" style=\"margin-left:-60px\" />\n<\/div><\/div>\n<div itemprop=\"reviewRating\" itemscope itemtype=\"https://schema.org/Rating\" class=\"BVRRRatingNormalOutOf\"> <span itemprop=\"ratingValue\" class=\"BVRRNumber BVRRRatingNumber\">1<\/span>\n <span class=\"BVRRSeparatorText\">out of<\/span>\n <span itemprop=\"bestRating\" class=\"BVRRNumber BVRRRatingRangeNumber\">5<\/span>\n<\/div><\/div><\/div><\/div> <\/div>\n<\/div>\n<div class=\"BVRRReviewTitleContainer\"><span class=\"BVRRLabel BVRRReviewTitlePrefix\"><\/span><span itemprop=\"name\" class=\"BVRRValue BVRRReviewTitle\">Broke on first use.<\/span><span class=\"BVRRLabel BVRRReviewTitleSuffix\">, <\/span><\/div>\n<div class=\"BVRRReviewDateContainer\"><span class=\"BVRRLabel BVRRReviewDatePrefix\"><\/span><span class=\"BVRRValue BVRRReviewDate\">04/12/2026<meta itemprop=\"datePublished\" content=\"2026-04-12\"/><\/span><span class=\"BVRRLabel BVRRReviewDateSuffix\"><\/span><\/div>\n<div class=\"BVRRReviewDisplayStyle3Content\">\n <div itemprop=\"description\" class=\"BVRRReviewTextContainer\" >\n\n\n\n\n<div id=\"BVRRReviewAbbreviatedText422456354_t11tl91zqkjfg74db27puel9j_ID\" class=\"BVRRReviewAbbreviatedText\"><div class=\"BVRRReviewAbbreviatedTextParagraph BVRRReviewAbbreviatedTextFirstParagraph BVRRReviewAbbreviatedTextLastParagraph\"> <span class=\"BVRRReviewAbbreviatedText\">I have a 20 x 20 foot area I wanted to turn into a vegetable garden and was looking for a small tiller. This one had the power and size I needed, and it was on sale. Assebly took about 5 minutes. Then I started using it. There is no stabilizing feet<\/span>\n<span class=\"BVRRReviewAbbreviatedTextSuffix\"><span class=\"BVDI_AbbreviatedLinkPrefix\">...<\/span><span class=\"BVDI_AbbreviatedLink\"><a onclick=\" if(window.BVAnalyticsTracker){BVAnalyticsTracker.fireActionEvent(this);};&#10;$bv('#BVRRReviewAbbreviatedText422456354_t11tl91zqkjfg74db27puel9j_ID').toggleClass('BVDIHidden');$bv('#BVRRReview422456354_qbcnnj6hmtpq8pqv2eosyux2c_ID').toggleClass('BVDIHidden');bvStopPropagation(event);return false;\" name=\"BV_TrackingTag_Review_Display_ToggleReadMore\" href=\"#\" class=\"BVDILink \"><span class=\"BVDILinkSpan\">(read full review)<\/span><\/a><\/span><span class=\"BVDI_AbbreviatedLinkSuffix\"><\/span><\/span><\/div><\/div>\n<div id=\"BVRRReview422456354_qbcnnj6hmtpq8pqv2eosyux2c_ID\" class=\"BVRRReviewText BVDIHidden\"><div class=\"BVRRReviewTextParagraph BVRRReviewTextFirstParagraph BVRRReviewTextLastParagraph\"> <span class=\"BVRRReviewText\">I have a 20 x 20 foot area I wanted to turn into a vegetable garden and was looking for a small tiller. This one had the power and size I needed, and it was on sale. Assebly took about 5 minutes. Then I started using it. There is no stabilizing feet stake, so the tiller bucked, was difficult to steer, and tried to pull both my husband and I. About half-way through the tilling, the throttle became unresponsive. The control cable between the lever and control valve broke. Packed it up and will return for refund tomorrow.<\/span>\n<span class=\"BVRRReviewTextSuffix\"><span class=\"BVDI_FullLinkPrefix\"><\/span><span class=\"BVDI_FullLink\"><a onclick=\" if(window.BVAnalyticsTracker){BVAnalyticsTracker.fireActionEvent(this);};&#10;$bv('#BVRRReviewAbbreviatedText422456354_t11tl91zqkjfg74db27puel9j_ID').toggleClass('BVDIHidden');$bv('#BVRRReview422456354_qbcnnj6hmtpq8pqv2eosyux2c_ID').toggleClass('BVDIHidden');bvStopPropagation(event);return false;\" name=\"BV_TrackingTag_Review_Display_ToggleReadMore\" href=\"#\" class=\"BVDILink \"><span class=\"BVDILinkSpan\">(hide full review)<\/span><\/a><\/span><span class=\"BVDI_FullLinkSuffix\"><\/span><\/span><\/div><\/div> <\/div>\n\n\n\n\n\n<\/div>\n\n <div class=\"RRBeforeFeedbackContainerSpacer\"><\/div>\n\n\n<div class=\"BVDI_FV\"><div class=\"BVDI_FVVoting BVDI_FVVotingHelpfulness\"><div class=\"BVDI_FVSum BVDI_FVSumHelpfulness\"><span class=\"BVDI_FVZero BVDI_FVLevel1\"><span class=\"BVDIValue BVDINumber\">0<\/span><span class=\"BVDISuffix\">points<\/span><\/span><\/div><div class=\"BVDI_FVCounts BVDI_FVCountsHelpfulness\"><\/div><div class=\"BVDI_FVVotes BVDI_FVVotesHelpfulness\"><span class=\"BVDIPrefix\">Was this helpful?<\/span><span class=\"BVDI_FVVote BVDI_FVPositive BVDI_FVLevel1\"><a data-bvjsref=\"https://walmart.ugc.bazaarvoice.com/submit/1336/11978119870/review/422456354/positive.djs?authsourcetype=__AUTHTYPE__&amp;format=embeddedhtml&amp;innerreturn=https%3A%2F%2Fwalmart.ugc.bazaarvoice.com%2F1336%2F11978119870%2Freviews.djs%3Fformat%3Dembeddedhtml%26num%3D100%26sort%3DsubmissionTime&amp;return=__RETURN__&amp;sessionparams=__BVSESSIONPARAMS__&amp;submissionparams=__BVSUBMISSIONPARAMETERS__&amp;submissionurl=__BVSUBMISSIONURL__&amp;user=__USERID__\" data-bvcfg=\"__CONFIGKEY__\" name=\"BV_TrackingTag_Review_Display_AddPositiveFeedback_422456354\" href=\"javascript://\" title=\"Yes\" class=\"BVDILink BVDIValue\"><span class=\"BVDILinkSpan\"><span class=\"BVDINumber\">0<\/span><\/span><\/a><\/span><span class=\"BVDI_FVVote BVDI_FVNegative BVDI_FVLevel1\"><a data-bvjsref=\"https://walmart.ugc.bazaarvoice.com/submit/1336/11978119870/review/422456354/negative.djs?authsourcetype=__AUTHTYPE__&amp;format=embeddedhtml&amp;innerreturn=https%3A%2F%2Fwalmart.ugc.bazaarvoice.com%2F1336%2F11978119870%2Freviews.djs%3Fformat%3Dembeddedhtml%26num%3D100%26sort%3DsubmissionTime&amp;return=__RETURN__&amp;sessionparams=__BVSESSIONPARAMS__&amp;submissionparams=__BVSUBMISSIONPARAMETERS__&amp;submissionurl=__BVSUBMISSIONURL__&amp;user=__USERID__\" data-bvcfg=\"__CONFIGKEY__\" name=\"BV_TrackingTag_Review_Display_AddNegativeFeedback_422456354\" href=\"javascript://\" title