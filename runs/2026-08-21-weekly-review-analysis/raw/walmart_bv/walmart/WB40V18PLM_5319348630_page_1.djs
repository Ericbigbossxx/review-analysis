itemscope itemtype=\"https://schema.org/Review\"><div class=\"BVRRSeparator BVRRSeparatorContentBodyTop\"><\/div>\n\n <div id=\"BVSubmissionPopupContainer\" class=\"BVRRReviewDisplayStyle3\">\n <div class=\"BVRRReviewDisplayStyle3Spacer BVRRReviewDisplayStyle3SpacerTop\"><\/div>\n<div class=\"BVRRReviewDisplayStyle3Summary\">\n<div class=\"BVRRUserNicknameContainer\"><span class=\"BVRRLabel BVRRUserNicknamePrefix\">By <\/span><span class=\"BVRRValue BVRRUserNickname\"><a onclick=\"var popupWin = parent.window.open(this.href, null, 'resizable=1,status=1,scrollbars=1,width=800,height=600,top=0'); popupWin.focus(); event.preventDefault?event.preventDefault():event.returnValue = false;\" name=\"BV_TrackingTag_Review_Display_ReadAllReviews_af24e6fc0304663cb0da156446c4ba67\" data-bvtrack=\"eName:ProfileLink\" href=\"https://walmart.ugc.bazaarvoice.com/profiles/1336/af24e6fc0304663cb0da156446c4ba67/profile.htm\"><span itemprop=\"author\" class=\"BVRRNickname\">Mark <\/span><\/a><\/span><div class=\"BVRRUserNicknameReadReviewsContainer\"><a onclick=\"var popupWin = parent.window.open(this.href, null, 'resizable=1,status=1,scrollbars=1,width=800,height=600,top=0'); popupWin.focus(); event.preventDefault?event.preventDefault():event.returnValue = false;\" name=\"BV_TrackingTag_Review_Display_ReadAllReviews_af24e6fc0304663cb0da156446c4ba67\" data-bvtrack=\"eName:ProfileLink\" href=\"https://walmart.ugc.bazaarvoice.com/profiles/1336/af24e6fc0304663cb0da156446c4ba67/profile.htm\" class=\"BVRRUserProfileImageLink\"><img src=\"https://walmart.ugc.bazaarvoice.com/static/1336/more_reviews_icon.gif\" alt=\"\" /><\/a><a onclick=\"var popupWin = parent.window.open(this.href, null, 'resizable=1,status=1,scrollbars=1,width=800,height=600,top=0'); popupWin.focus(); event.preventDefault?event.preventDefault():event.returnValue = false;\" name=\"BV_TrackingTag_Review_Display_ReadAllReviews_af24e6fc0304663cb0da156446c4ba67\" data-bvtrack=\"eName:ProfileLink\" href=\"https://walmart.ugc.bazaarvoice.com/profiles/1336/af24e6fc0304663cb0da156446c4ba67/profile.htm\"><\/a><\/div><\/div>\n<div class=\"BVDI_BA BVDI_BAReview\"><div class=\"BVDIInside BVDI_BAInside\"><div class=\"BVDIBody BVDI_BABody\"><ul class=\"BVDI_BAList\"><li class=\"BVDI_BAItem BVDI_BAItemOdd BVDI_BAItemVerifiedPurchaser\"><div id=\"BVDI_BAPopup_ezv6czbtaf5tuszmf18692ujm_ID\" class=\"BVDIPopup BVDI_BAPopup BVDI_BAPopupVerifiedPurchaser\" style=\"display: none;\"><div class=\"BVDIInside BVDI_BAInsidePopup\"><div class=\"BVDIBody BVDI_BAPopupBody\"><dl class=\"BVDI_BAList\"><dt class=\"BVDI_BAItem BVDI_BAItemOnly BVDI_BAItemVerifiedPurchaser\">\n<a onclick=\"return false;\" class=\"BVDILink BVDILinkDisabled\"> <span class=\"BVDILinkSpan\">Verified Purchaser<\/span><\/a><\/dt><dd><p>Customer has been confirmed to have purchased the item from Walmart.<\/p><\/dd><\/dl><\/div><\/div><\/div>\n<a onclick=\"return false;\" class=\"BVDILink BVDILinkDisabled\" id=\"BVDI_BABadge_dws6e3lcktea1901mp1l90grz_ID\"onmouseover=\"bvTooltip.show(&quot;BVDI_BAPopup_ezv6czbtaf5tuszmf18692ujm_ID&quot;, this.id, false, []);\"onmouseout=\"bvTooltip.hide();\"> <span class=\"BVDILinkSpan\">Verified Purchaser<\/span><\/a><\/li><\/ul><\/div><\/div><\/div>\n <div class=\"BVRRCustomUserInfoContainer\">\n<div class=\"BVRRRecommendedContainer BVRRRecommendedContainerYes\"><span class=\"BVRRLabel BVRRRecommendedPrefix\">Recommends this product? <\/span><span class=\"BVRRValue BVRRRecommended\">Yes<\/span><span class=\"BVRRLabel BVRRRecommendedSuffix\"><\/span><\/div><div class=\"BVRRContextDataContainer\"><\/div> <\/div>\n\n\n\n\n\n\n<\/div>\n<div class=\"BVRRReviewDisplayStyle3Main\">\n <div class=\"BVRRReviewDisplayStyle3MainSpacer BVRRReviewDisplayStyle3MainSpacerTop\"><\/div>\n\n<div class=\"BVRRReviewRatingsContainer\"> <div class=\"BVRROverallRatingContainer\" >\n<div class=\"BVRRRatingContainerStar\"><div class=\"BVRRRatingEntry BVRROdd\"><div id=\"BVRRRatingOverall_Review_Display\" class=\"BVRRRating BVRRRatingNormal BVRRRatingOverall\"><div class=\"BVRRLabel BVRRRatingNormalLabel\"><\/div><div class=\"BVRRRatingNormalImage\">\n<div class=\"BVImgOrSprite\" style=\"width:75px;height:15px;overflow:hidden\"><img src=\"https://walmart.ugc.bazaarvoice.com/1336/5_0/9/rating.png\" alt=\"5 out of 5\" title=\"5 out of 5\" width=\"135\" height=\"15\" />\n<\/div><\/div>\n<div itemprop=\"reviewRating\" itemscope itemtype=\"https://schema.org/Rating\" class=\"BVRRRatingNormalOutOf\"> <span itemprop=\"ratingValue\" class=\"BVRRNumber BVRRRatingNumber\">5<\/span>\n <span class=\"BVRRSeparatorText\">out of<\/span>\n <span itemprop=\"bestRating\" class=\"BVRRNumber BVRRRatingRangeNumber\">5<\/span>\n<\/div><\/div><\/div><\/div> <\/div>\n<\/div>\n<div class=\"BVRRReviewTitleContainer\"><span class=\"BVRRLabel BVRRReviewTitlePrefix\"><\/span><span itemprop=\"name\" class=\"BVRRValue BVRRReviewTitle\">Great Product Support<\/span><span class=\"BVRRLabel BVRRReviewTitleSuffix\">, <\/span><\/div>\n<div class=\"BVRRReviewDateContainer\"><span class=\"BVRRLabel BVRRReviewDatePrefix\"><\/span><span class=\"BVRRValue BVRRReviewDate\">07/23/2025<meta itemprop=\"datePublished\" content=\"2025-07-23\"/><\/span><span class=\"BVRRLabel BVRRReviewDateSuffix\"><\/span><\/div>\n<div class=\"BVRRReviewDisplayStyle3Content\">\n <div itemprop=\"description\" class=\"BVRRReviewTextContainer\" >\n\n\n\n\n<div id=\"BVRRReviewAbbreviatedText393099696_kw08f3egelibxzyjc3umbb3i2_ID\" class=\"BVRRReviewAbbreviatedText\"><div class=\"BVRRReviewAbbreviatedTextParagraph BVRRReviewAbbreviatedTextFirstParagraph BVRRReviewAbbreviatedTextLastParagraph\"> <span class=\"BVRRReviewAbbreviatedText\">The reason I gave this a 5 star rating is because of the great support from Sunseeker North America, Inc., https://www.linkedin.com/company/sunseeker-us/.<br />I had a battery that wouldn't charge properly when I got the mower. Sent an email with photos<\/span>\n<span class=\"BVRRReviewAbbreviatedTextSuffix\"><span class=\"BVDI_AbbreviatedLinkPrefix\">...<\/span><span class=\"BVDI_AbbreviatedLink\"><a onclick=\" if(window.BVAnalyticsTracker){BVAnalyticsTracker.fireActionEvent(this);};&#10;$bv('#BVRRReviewAbbreviatedText393099696_kw08f3egelibxzyjc3umbb3i2_ID').toggleClass('BVDIHidden');$bv('#BVRRReview393099696_ospbv6wkjn0u6vh41w9yunc1d_ID').toggleClass('BVDIHidden');bvStopPropagation(event);return false;\" name=\"BV_TrackingTag_Review_Display_ToggleReadMore\" href=\"#\" class=\"BVDILink \"><span class=\"BVDILinkSpan\">(read full review)<\/span><\/a><\/span><span class=\"BVDI_AbbreviatedLinkSuffix\"><\/span><\/span><\/div><\/div>\n<div id=\"BVRRReview393099696_ospbv6wkjn0u6vh41w9yunc1d_ID\" class=\"BVRRReviewText BVDIHidden\"><div class=\"BVRRReviewTextParagraph BVRRReviewTextFirstParagraph BVRRReviewTextLastParagraph\"> <span class=\"BVRRReviewText\">The reason I gave this a 5 star rating is because of the great support from Sunseeker North America, Inc., https://www.linkedin.com/company/sunseeker-us/.<br />I had a battery that wouldn't charge properly when I got the mower. Sent an email with photos and description of the problem. They sent a new battery and charger that day or early the next by USPS Ground Advantage. Now I have two chargers and one battery that work.<br />The included operations manual was hard to read, but I downloaded a PDF one that was better.<br />One thing they don't tell you in any of the description is that when you mow thick grass there is a turbo boost that kicks in, which is great, but does uses more battery.<\/span>\n<span class=\"BVRRReviewTextSuffix\"><span class=\"BVDI_FullLinkPrefix\"><\/span><span class=\"BVDI_FullLink\"><a onclick=\" if(window.BVAnalyticsTracker){BVAnalyticsTracker.fireActionEvent(this);};&#10;$bv('#BVRRReviewAbbreviatedText393099696_kw08f3egelibxzyjc3umbb3i2_ID').toggleClass('BVDIHidden');$bv('#BVRRReview393099696_ospbv6wkjn0u6vh41w9yunc1d_ID').toggleClass('BVDIHidden');bvStopPropagation(event);return false;\" name=\"BV_TrackingTag_Review_Display_ToggleReadMore\" href=\"#\" class=\"BVDILink \"><span class=\"BVDILinkSpan\">(hide full review)<\/span><\/a><\/span><span class=\"BVDI_FullLinkSuffix\"><\/span><\/span><\/div><\/div> <\/div>\n\n\n\n\n\n<\/div>\n\n <div class=\"RRBeforeFeedbackContainerSpacer\"><\/div>\n\n\n<div class=\"BVDI_FV\"><div class=\"BVDI_FVVoting BVDI_FVVotingHelpfulness\"><div class=\"BVDI_FVSum BVDI_FVSumHelpfulness\"><span class=\"BVDI_FVPositive BVDI_FVLevel2\"><span class=\"BVDIPrefix\">+<\/span><span class=\"BVDIValue BVDINumber\">2<\/span><span class=\"BVDISuffix\">points<\/span><\/span><\/div><div class=\"BVDI_FVCounts BVDI_FVCountsHelpfulness\"><\/div><div class=\"BVDI_FVVotes BVDI_FVVotesHelpfulness\"><span class=\"BVDIPrefix\">Was this helpful?<\/span><span class=\"BVDI_FVVote BVDI_FVPositive BVDI_FVLevel2\"><a data-bvjsref=\"https://walmart.ugc.bazaarvoice.com/submit/1336/5319348630/review/393099696/positive.djs?authsourcetype=__AUTHTYPE__&amp;format=embeddedhtml&amp;innerreturn=https%3A%2F%2Fwalmart.ugc.bazaarvoice.com%2F1336%2F5319348630%2Freviews.djs%3Fformat%3Dembeddedhtml%26num%3D100%26sort%3DsubmissionTime&amp;return=__RETURN__&amp;sessionparams=__BVSESSIONPARAMS__&amp;submissionparams=__BVSUBMISSIONPARAMETERS__&amp;submissionurl=__BVSUBMISSIONURL__&amp;user=__USERID__\" data-bvcfg=\"__CONFIGKEY__\" name=\"BV_TrackingTag_Review_Display_AddPositiveFeedback_393099696\" href=\"javascript://\" title=\"Yes\" class=\"BVDILink BVDIValue\"><span class=\"BVDILinkSpan\"><span class=\"BVDINumber\">2<\/span><\/span><\/a><\/span><span class=\"BVDI_FVVote BVDI_FVNegative BVDI_FVLevel1\"><a data-bvjsref=\"https://walmart.ugc.bazaarvoice.com/submit/1336/5319348630/review/393099696/negative.djs?authsourcetype=__AUTHTYPE__&amp;format=embeddedhtml&amp;innerreturn=https%3A%2F%2Fwalmart.ugc.bazaarvoice.com%2F1336%2F5319348630%2Freviews.djs%3Fformat%3Dembeddedhtml%26num%3D100%26sort%3DsubmissionTime&amp;return=__RETURN__&amp;sessionparams=__BVSESSIONPARAMS__&amp;submissionparams=__BVSUBMISSI