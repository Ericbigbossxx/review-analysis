 data-bvtrack=\"eName:ProfileLink\" href=\"https://walmart.ugc.bazaarvoice.com/profiles/1336/0618639e040e2f34ab7b6faa769f49ed/profile.htm\"><\/a><\/div><\/div>\n<div class=\"BVDI_BA BVDI_BAReview\"><div class=\"BVDIInside BVDI_BAInside\"><div class=\"BVDIBody BVDI_BABody\"><ul class=\"BVDI_BAList\"><li class=\"BVDI_BAItem BVDI_BAItemOdd BVDI_BAItemVerifiedPurchaser\"><div id=\"BVDI_BAPopup_aslcagxe6sbqo2rd172xxjkhs_ID\" class=\"BVDIPopup BVDI_BAPopup BVDI_BAPopupVerifiedPurchaser\" style=\"display: none;\"><div class=\"BVDIInside BVDI_BAInsidePopup\"><div class=\"BVDIBody BVDI_BAPopupBody\"><dl class=\"BVDI_BAList\"><dt class=\"BVDI_BAItem BVDI_BAItemOnly BVDI_BAItemVerifiedPurchaser\">\n<a onclick=\"return false;\" class=\"BVDILink BVDILinkDisabled\"> <span class=\"BVDILinkSpan\">Verified Purchaser<\/span><\/a><\/dt><dd><p>Customer has been confirmed to have purchased the item from Walmart.<\/p><\/dd><\/dl><\/div><\/div><\/div>\n<a onclick=\"return false;\" class=\"BVDILink BVDILinkDisabled\" id=\"BVDI_BABadge_hn5oovyt79lk705vnnq51l3u9_ID\"onmouseover=\"bvTooltip.show(&quot;BVDI_BAPopup_aslcagxe6sbqo2rd172xxjkhs_ID&quot;, this.id, false, []);\"onmouseout=\"bvTooltip.hide();\"> <span class=\"BVDILinkSpan\">Verified Purchaser<\/span><\/a><\/li><\/ul><\/div><\/div><\/div>\n <div class=\"BVRRCustomUserInfoContainer\">\n<div class=\"BVRRContextDataContainer\"><\/div> <\/div>\n\n\n\n\n\n\n<\/div>\n<div class=\"BVRRReviewDisplayStyle3Main\">\n <div class=\"BVRRReviewDisplayStyle3MainSpacer BVRRReviewDisplayStyle3MainSpacerTop\"><\/div>\n\n<div class=\"BVRRReviewRatingsContainer\"> <div class=\"BVRROverallRatingContainer\" >\n<div class=\"BVRRRatingContainerStar\"><div class=\"BVRRRatingEntry BVRROdd\"><div id=\"BVRRRatingOverall_Review_Display\" class=\"BVRRRating BVRRRatingNormal BVRRRatingOverall\"><div class=\"BVRRLabel BVRRRatingNormalLabel\"><\/div><div class=\"BVRRRatingNormalImage\">\n<div class=\"BVImgOrSprite\" style=\"width:75px;height:15px;overflow:hidden\"><img src=\"https://walmart.ugc.bazaarvoice.com/1336/5_0/9/rating.png\" alt=\"5 out of 5\" title=\"5 out of 5\" width=\"135\" height=\"15\" />\n<\/div><\/div>\n<div itemprop=\"reviewRating\" itemscope itemtype=\"https://schema.org/Rating\" class=\"BVRRRatingNormalOutOf\"> <span itemprop=\"ratingValue\" class=\"BVRRNumber BVRRRatingNumber\">5<\/span>\n <span class=\"BVRRSeparatorText\">out of<\/span>\n <span itemprop=\"bestRating\" class=\"BVRRNumber BVRRRatingRangeNumber\">5<\/span>\n<\/div><\/div><\/div><\/div> <\/div>\n<\/div>\n<div class=\"BVRRReviewTitleContainer\"><span class=\"BVRRLabel BVRRReviewTitlePrefix\"><\/span><span itemprop=\"name\" class=\"BVRRValue BVRRReviewTitle\">works great<\/span><span class=\"BVRRLabel BVRRReviewTitleSuffix\">, <\/span><\/div>\n<div class=\"BVRRReviewDateContainer\"><span class=\"BVRRLabel BVRRReviewDatePrefix\"><\/span><span class=\"BVRRValue BVRRReviewDate\">05/25/2025<meta itemprop=\"datePublished\" content=\"2025-05-25\"/><\/span><span class=\"BVRRLabel BVRRReviewDateSuffix\"><\/span><\/div>\n<div class=\"BVRRReviewDisplayStyle3Content\">\n <div itemprop=\"description\" class=\"BVRRReviewTextContainer\" >\n\n\n\n\n<div id=\"BVRRReviewAbbreviatedText386655166_eqbvy1xppttz588xx2ecvfwrw_ID\" class=\"BVRRReviewAbbreviatedText\"><div class=\"BVRRReviewAbbreviatedTextParagraph BVRRReviewAbbreviatedTextFirstParagraph BVRRReviewAbbreviatedTextLastParagraph\"> <span class=\"BVRRReviewAbbreviatedText\">easy to put together, one charge handles my backyard and maybe front yard, 80 by 100 lot. kinda quiet compared with gas mower, and easy push button start. i don't mind that it's not self propelled. and super easy to adjust wheel height! wow,<\/span>\n<span class=\"BVRRReviewAbbreviatedTextSuffix\"><span class=\"BVDI_AbbreviatedLinkPrefix\">...<\/span><span class=\"BVDI_AbbreviatedLink\"><a onclick=\" if(window.BVAnalyticsTracker){BVAnalyticsTracker.fireActionEvent(this);};&#10;$bv('#BVRRReviewAbbreviatedText386655166_eqbvy1xppttz588xx2ecvfwrw_ID').toggleClass('BVDIHidden');$bv('#BVRRReview386655166_tedvxfltaq422d9o51gr46h8d_ID').toggleClass('BVDIHidden');bvStopPropagation(event);return false;\" name=\"BV_TrackingTag_Review_Display_ToggleReadMore\" href=\"#\" class=\"BVDILink \"><span class=\"BVDILinkSpan\">(read full review)<\/span><\/a><\/span><span class=\"BVDI_AbbreviatedLinkSuffix\"><\/span><\/span><\/div><\/div>\n<div id=\"BVRRReview386655166_tedvxfltaq422d9o51gr46h8d_ID\" class=\"BVRRReviewText BVDIHidden\"><div class=\"BVRRReviewTextParagraph BVRRReviewTextFirstParagraph BVRRReviewTextLastParagraph\"> <span class=\"BVRRReviewText\">easy to put together, one charge handles my backyard and maybe front yard, 80 by 100 lot. kinda quiet compared with gas mower, and easy push button start. i don't mind that it's not self propelled. and super easy to adjust wheel height! wow, would definitely recommenda<\/span>\n<span class=\"BVRRReviewTextSuffix\"><span class=\"BVDI_FullLinkPrefix\"><\/span><span class=\"BVDI_FullLink\"><a onclick=\" if(window.BVAnalyticsTracker){BVAnalyticsTracker.fireActionEvent(this);};&#10;$bv('#BVRRReviewAbbreviatedText386655166_eqbvy1xppttz588xx2ecvfwrw_ID').toggleClass('BVDIHidden');$bv('#BVRRReview386655166_tedvxfltaq422d9o51gr46h8d_ID').toggleClass('BVDIHidden');bvStopPropagation(event);return false;\" name=\"BV_TrackingTag_Review_Display_ToggleReadMore\" href=\"#\" class=\"BVDILink \"><span class=\"BVDILinkSpan\">(hide full review)<\/span><\/a><\/span><span class=\"BVDI_FullLinkSuffix\"><\/span><\/span><\/div><\/div> <\/div>\n\n\n\n\n\n<\/div>\n\n <div class=\"RRBeforeFeedbackContainerSpacer\"><\/div>\n\n\n<div class=\"BVDI_FV\"><div class=\"BVDI_FVVoting BVDI_FVVotingHelpfulness\"><div class=\"BVDI_FVSum BVDI_FVSumHelpfulness\"><span class=\"BVDI_FVPositive BVDI_FVLevel2\"><span class=\"BVDIPrefix\">+<\/span><span class=\"BVDIValue BVDINumber\">2<\/span><span class=\"BVDISuffix\">points<\/span><\/span><\/div><div class=\"BVDI_FVCounts BVDI_FVCountsHelpfulness\"><\/div><d