; popupWin.focus(); event.preventDefault?event.preventDefault():event.returnValue = false;\" name=\"BV_TrackingTag_Review_Display_ReadAllReviews_d3a8da41efae214b32aea5967e2d4dd5\" data-bvtrack=\"eName:ProfileLink\" href=\"https://walmart.ugc.bazaarvoice.com/profiles/1336/d3a8da41efae214b32aea5967e2d4dd5/profile.htm\" class=\"BVRRUserProfileImageLink\"><img src=\"https://walmart.ugc.bazaarvoice.com/static/1336/more_reviews_icon.gif\" alt=\"\" /><\/a><a onclick=\"var popupWin = parent.window.open(this.href, null, 'resizable=1,status=1,scrollbars=1,width=800,height=600,top=0'); popupWin.focus(); event.preventDefault?event.preventDefault():event.returnValue = false;\" name=\"BV_TrackingTag_Review_Display_ReadAllReviews_d3a8da41efae214b32aea5967e2d4dd5\" data-bvtrack=\"eName:ProfileLink\" href=\"https://walmart.ugc.bazaarvoice.com/profiles/1336/d3a8da41efae214b32aea5967e2d4dd5/profile.htm\"><\/a><\/div><\/div>\n<div class=\"BVDI_BA BVDI_BAReview\"><div class=\"BVDIInside BVDI_BAInside\"><div class=\"BVDIBody BVDI_BABody\"><ul class=\"BVDI_BAList\"><li class=\"BVDI_BAItem BVDI_BAItemOdd BVDI_BAItemVerifiedPurchaser\"><div id=\"BVDI_BAPopup_6ihu5xavsn1h2uiu5p49ai6li_ID\" class=\"BVDIPopup BVDI_BAPopup BVDI_BAPopupVerifiedPurchaser\" style=\"display: none;\"><div class=\"BVDIInside BVDI_BAInsidePopup\"><div class=\"BVDIBody BVDI_BAPopupBody\"><dl class=\"BVDI_BAList\"><dt class=\"BVDI_BAItem BVDI_BAItemOnly BVDI_BAItemVerifiedPurchaser\">\n<a onclick=\"return false;\" class=\"BVDILink BVDILinkDisabled\"> <span class=\"BVDILinkSpan\">Verified Purchaser<\/span><\/a><\/dt><dd><p>Customer has been confirmed to have purchased the item from Walmart.<\/p><\/dd><\/dl><\/div><\/div><\/div>\n<a onclick=\"return false;\" class=\"BVDILink BVDILinkDisabled\" id=\"BVDI_BABadge_dkjygxd3rpu5bofk45iozjaqn_ID\"onmouseover=\"bvTooltip.show(&quot;BVDI_BAPopup_6ihu5xavsn1h2uiu5p49ai6li_ID&quot;, this.id, false, []);\"onmouseout=\"bvTooltip.hide();\"> <span class=\"BVDILinkSpan\">Verified Purchaser<\/span><\/a><\/li><\/ul><\/div><\/div><\/div>\n <div class=\"BVRRCustomUserInfoContainer\">\n<div class=\"BVRRRecommendedContainer BVRRRecommendedContainerYes\"><span class=\"BVRRLabel BVRRRecommendedPrefix\">Recommends this product? <\/span><span class=\"BVRRValue BVRRRecommended\">Yes<\/span><span class=\"BVRRLabel BVRRRecommendedSuffix\"><\/span><\/div><div class=\"BVRRContextDataContainer\"><\/div> <\/div>\n\n\n\n\n\n\n<\/div>\n<div class=\"BVRRReviewDisplayStyle3Main\">\n <div class=\"BVRRReviewDisplayStyle3MainSpacer BVRRReviewDisplayStyle3MainSpacerTop\"><\/div>\n\n<div class=\"BVRRReviewRatingsContainer\"> <div class=\"BVRROverallRatingContainer\" >\n<div class=\"BVRRRatingContainerStar\"><div class=\"BVRRRatingEntry BVRROdd\"><div id=\"BVRRRatingOverall_Review_Display\" class=\"BVRRRating BVRRRatingNormal BVRRRatingOverall\"><div class=\"BVRRLabel BVRRRatingNormalLabel\"><\/div><div class=\"BVRRRatingNormalImage\">\n<div class=\"BVImgOrSprite\" style=\"width:75px;height:15px;overflow:hidden\"><img src=\"https://walmart.ugc.bazaarvoice.com/1336/5_0/9/rating.png\" alt=\"5 out of 5\" title=\"5 out of 5\" width=\"135\" height=\"15\" />\n<\/div><\/div>\n<div itemprop=\"reviewRating\" itemscope itemtype=\"https://schema.org/Rating\" class=\"BVRRRatingNormalOutOf\"> <span itemprop=\"ratingValue\" class=\"BVRRNumber BVRRRatingNumber\">5<\/span>\n <span class=\"BVRRSeparatorText\">out of<\/span>\n <span itemprop=\"bestRating\" class=\"BVRRNumber BVRRRatingRangeNumber\">5<\/span>\n<\/div><\/div><\/div><\/div> <\/div>\n<\/div>\n<div class=\"BVRRReviewTitleContainer\"><span class=\"BVRRLabel BVRRReviewTitlePrefix\"><\/span><span itemprop=\"name\" class=\"BVRRValue BVRRReviewTitle\">power motor<\/span><span class=\"BVRRLabel BVRRReviewTitleSuffix\">, <\/span><\/div>\n<div class=\"BVRRReviewDateContainer\"><span class=\"BVRRLabel BVRRReviewDatePrefix\"><\/span><span class=\"BVRRValue BVRRReviewDate\">07/24/2025<meta itemprop=\"datePublished\" content=\"2025-07-24\"/><\/span><span class=\"BVRRLabel BVRRReviewDateSuffix\"><\/span><\/div>\n<div class=\"BVRRReviewDisplayStyle3Content\">\n <div itemprop=\"description\" class=\"BVRRReviewTextContainer\" >\n\n\n\n\n<div id=\"BVRRReviewAbbreviatedText393169208_ep6pwwnkyttnw8reh9i7n7soe_ID\" class=\"BVRRReviewAbbreviatedText\"><div class=\"BVRRReviewAbbreviatedTextParagraph BVRRReviewAbbreviatedTextFirstParagraph BVRRReviewAbbreviatedTextLastParagraph\"> <span class=\"BVRRReviewAbbreviatedText\">The self adjusting speed to cut thicker patched grass is a game changer. I did not have to switch positions for it to ramp up. the height adjustment is easy to maneuver and the top height is higher than others I had used. The larger battery also is a<\/span>\n<span class=\"BVRRReviewAbbreviatedTextSuffix\"><span class=\"BVDI_AbbreviatedLinkPrefix\">...<\/span><span class=\"BVDI_AbbreviatedLink\"><a onclick=\" if(window.BVAnalyticsTracker){BVAnalyticsTracker.fireActionEvent(this);};&#10;$bv('#BVRRReviewAbbreviatedText393169208_ep6pwwnkyttnw8reh9i7n7soe_ID').toggleClass('BVDIHidden');$bv('#BVRRReview393169208_i6wxr4d9zr6n9dzsx2srhh3ig_ID').toggleClass('BVDIHidden');bvStopPropagation(event);return false;\" name=\"BV_TrackingTag_Review_Display_ToggleReadMore\" href=\"#\" class=\"BVDILink \"><span class=\"BVDILinkSpan\">(read full review)<\/span><\/a><\/span><span class=\"BVDI_AbbreviatedLinkSuffix\"><\/span><\/span><\/div><\/div>\n<div id=\"BVRRReview393169208_i6wxr4d9zr6n9dzsx2srhh3ig_ID\" class=\"BVRRReviewText BVDIHidden\"><div class=\"BVRRReviewTextParagraph BVRRReviewTextFirstParagraph BVRRReviewTextLastParagraph\"> <span class=\"BVRRReviewText\">The self adjusting speed to cut thicker patched grass is a game changer. I did not have to switch positions for it to ramp up. the height adjustment is easy to maneuver and the top height is higher than others I had used. The larger battery also is a plus for me. I did not need to charge during my cut from the front yard and back. cordless gave me less work to do since I did not have to get the heavy-duty extension cord. This mower bag for extra grass clippings is easy to apply and take off.<\/span>\n<span class=\"BVRRReviewTextSuffix\"><span class=\"BVDI_FullLinkPrefix\"><\/span><span class=\"BVDI_FullLink\"><a onclick=\" if(window.BVAnalyticsTracker){BVAnalyticsTracker.fireActionEvent(this);};&#10;$bv('#BVRRReviewAbbreviatedText393169208_ep6pwwnkyttnw8reh9i7n7soe_ID').toggleClass('BVDIHidden');$bv('#BVRRReview393169208_i6wxr4d9zr6n9dzsx2srhh3ig_ID').toggleClass('BVDIHidden');bvStopPropagation(event);return false;\" name=\"BV_TrackingTag_Review_Display_ToggleReadMore\" href=\"#\" class=\"BVDILink \"><span class=\"BVDILinkSpan\">(hide full review)<\/span><\/a><\/span><span class=\"BVDI_FullLinkSuffix\"><\/span><\/span><\/div><\/div> <\/div>\n\n\n\n\n\n<\/div>\n\n <div class=\"RRBeforeFeedbackContainerSpacer\"><\/div>\n\n\n<div class=\"BVDI_FV\"><div class=\"BVDI_FVVoting BVDI_FVVotingHelpfulness\"><div class=\"BVDI_FVSum BVDI_FVSumHelpfulness\"><span class=\"BVDI_FVPositive BVDI_FVLevel3\"><span class=\"BVDIPrefix\">+<\/span><span class=\"BVDIValue BVDINumber\">5<\/span><span class=\"BVDISuffix\">points<\/span><\/span><\/div><div class=\"BVDI_FVCounts BVDI_FVCountsHelpfulness\"><\/div><div class=\"BVDI_FVVotes BVDI_FVVotesHelpfulness\"><span class=\"BVDIPrefix\">Was this helpful?<\/span><span class=\"BVDI_FVVote BVDI_FVPositive BVDI_FVLevel3\"><a data-bvjsref=\"https://walmart.ugc.bazaarvoice.com/submit/1336/5319348630/review/393169208/positive.djs?authsourcetype=__AUTHTYPE__&amp;format=embeddedhtml&amp;innerreturn=https%3A%2F%2Fwalmart.ugc.bazaarvoice.com%2F1336%2F5319348630%2Freviews.djs%3Fformat%3Dembeddedhtml%26num%3D100%26sort%3DsubmissionTime&amp;return=__RETURN__&amp;sessionparams=__BVSESSIONPARAMS__&amp;submissionparams=__BVSUBMISSIONPARAMETERS__&amp;submissionurl=__BVSUBMISSIONURL__&amp;user=__USERID__\" data-bvcfg=\"__CONFIGKEY__\" name=\"BV_TrackingTag_Review_Display_AddPositiveFeedback_393169208\" hre